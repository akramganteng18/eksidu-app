# ============================================================
#  EKSiDU — contoh konfigurasi lingkungan
#  Salin menjadi .env :  copy .env.example .env   (Windows)
#                        cp .env.example .env      (Linux/macOS)
#  Lalu jalankan:        php artisan key:generate
#  JANGAN pernah membagikan file .env yang sudah terisi.
# ============================================================
APP_NAME=EKSiDU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Alamat publik/host yang dipakai pada tautan QR. Untuk HP di Wi-Fi yang sama,
# set APP_URL dan EKSIDU_PUBLIC_URL ke IP LAN PC. Untuk internet tanpa VPN,
# set keduanya ke domain HTTPS pada hosting/VPS/server sekolah.
# Contoh LAN: http://192.168.1.10/eksidu/public atau http://192.168.1.10:8000
# Contoh internet: https://eksidu.sekolah.sch.id
# Jangan gunakan localhost/127.0.0.1 untuk QR yang dipindai perangkat lain.
EKSIDU_PUBLIC_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Nama database contoh untuk instalasi baru adalah "eksidu". Saat update database lama,
# pertahankan nama database yang sudah dipakai (misalnya "simada") pada .env lama.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eksidu
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@smkn5surakarta.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Khusus EKSiDU ----------
# Registrasi mandiri siswa. Biarkan false: akun dibuat oleh Admin/TU.
EKSIDU_REGISTRASI_PUBLIK=false

# Akun admin awal untuk "php artisan db:seed".
# Di produksi WAJIB isi ADMIN_PASSWORD yang kuat. Jika kosong dan APP_ENV bukan local,
# seeder membuat kata sandi acak dan menampilkannya SEKALI di terminal.
ADMIN_NAME="Admin TU SMKN 5 Surakarta"
ADMIN_EMAIL=admin@smkn5surakarta.sch.id
ADMIN_PASSWORD=

# Kotak "akun demo" di halaman login + data demo. Untuk pengembangan lokal.
EKSIDU_AKUN_DEMO=false
# Hanya untuk hosting demo terkontrol; tetap gunakan APP_ENV=production dan APP_DEBUG=false.
# Jika diaktifkan, EKSIDU_DEMO_PASSWORD wajib minimal 12 karakter.
EKSIDU_SEED_DEMO_PRODUCTION=false

# Kirim salinan notifikasi status via email (aktifkan setelah SMTP diuji).
EKSIDU_NOTIFIKASI_EMAIL=false
EKSIDU_DEMO_PASSWORD=

# Batas unggah media panduan (KB). Pastikan upload_max_filesize & post_max_size di php.ini cukup.
EKSIDU_BATAS_MEDIA_KB=51200
